+  private class Indexed extends Bundle {
+    val lane = UInt(laneWidth.W)
+    val base = UInt(32.W)
+    val texWidth = UInt(14.W)
+    val x = Vec(2, UInt(14.W))
+    val y = Vec(2, UInt(14.W))
