  "contract": {
    "handle": "firstHandle+n names records.base+64*n; one line per immutable record; primitive and state share an arena",
    "admission": "Snapshot descriptors; require matching context/pass/generation, aligned bounded records, nonoverlap with a nonempty bin arena and a nonwrapping 32-bit handle interval.",
    "output": "Only fully fetched primitive/state pairs are offered, with original identity, tile, ordinal, handles, sequence and token; failed pairs emit no substitute record.",
    "invalid_handle": "Check both handles before either read. Wrapper status 8 preserves all original bin statuses including invalidPage=6 and closed=7.",
    "completion": "Per-engine ordered outputs and tile results. A tile waits for all offered pairs. Each engine reserves tileSlots result entries so empty/cancelled results cannot block the shared replay result port.",
    "faults": "A record fault poisons only that engine for the pass. Other engines continue. Consumers discard failed tile outputs; memoryFault takes precedence over cancelled.",
    "cancellation": "Retain offered reads and complete pairs, discard unfinished pairs and drain every result before pass rebinding; held published results stay stable.",
    "lifetime": "Pass begin invalidates every cache entry; records remain immutable and published to this uncached memory domain through the held summary.",
    "counters": "Raw replay references and bin lines are distinct from resolved pairs and record lookups/hits/misses/readLines."
  },
