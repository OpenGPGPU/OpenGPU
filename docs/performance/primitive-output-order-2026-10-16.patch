+package opengpu.graphics
+
+import chisel3._
+import chisel3.reflect.DataMirror
+import opengpu.config.GpuConfig
+import opengpu.testutil.GpuSim._
+import org.scalatest.flatspec.AnyFlatSpec
+import scala.collection.mutable
+
+class PrimitiveFragmentSchedulerSpec extends AnyFlatSpec {
+  behavior of "PrimitiveFragmentScheduler"
+  private val cases = Seq((1,4,2,0), (2,4,2,0), (4,4,2,4),
+    (4,8,2,0), (4,16,7,112), (4,16,8,0))
+  for ((count, lanes, warps, limit) <- cases) {
+    it should s"drain ready primitive batches across $count workers lanes=$lanes warps=$warps limit=$limit" in {
+      val config = GpuConfig(lanes=lanes, warps=warps)
+      val capacity = if (limit == 0) lanes*warps else limit
+      val quadsPerBatch = capacity/4
+      val gfx = GraphicsConfig(screenWidth=256, screenHeight=16, fragmentBatchLimit=limit)
+      val reorder = !sys.props.contains("opengpu.primitiveOrderedControl")
+      simulate(new PrimitiveFragmentScheduler(config, gfx, count, reorder=reorder)) { dut =>
+        def zero(d: Data): Unit = d match {
+          case r: Record => r.elements.values.foreach(zero)
+          case v: Vec[_] => v.foreach(zero)
+          case b: Bool if DataMirror.directionOf(b) == ActualDirection.Input => b.poke(false.B)
+          case s: SInt if DataMirror.directionOf(s) == ActualDirection.Input => s.poke(0.S)
+          case u: UInt if DataMirror.directionOf(u) == ActualDirection.Input => u.poke(0.U)
+          case _ => ()
+        }
+        zero(dut.io)
+        val front = dut.io.front
+        val stride = (9*4*lanes*warps+256+63)& ~63
+        front.kernargBase.poke(0x8000.U)
+        front.kernargBankStride.poke(stride.U)
+        front.shaderPc.poke(0x1000.U)
+        dut.io.workers.foreach(_.fragIn.ready.poke(true.B))
+        dut.reset.poke(true.B); dut.clock.step(); dut.reset.poke(false.B)
+        case class Sample(id: Int, draw: Int, x: Int, covered: Boolean)
+        case class Worker(input: mutable.ArrayBuffer[Sample], output: mutable.Queue[Sample],
+          var started: Boolean=false, var delay: Int=0)
+        val models = Array.fill(count)(Worker(mutable.ArrayBuffer.empty, mutable.Queue.empty))
+        val expected = mutable.Map.empty[Int, Sample]
+        val observed = mutable.ArrayBuffer.empty[Int]
+        var cycles = 0
+        var nextQuad = 0
+        var producerDraw = 0
+        var retireCount = 0
+        var blockedDraw: Option[Int] = if (count > 1) Some(0) else None
+        var stalled: Option[(Int,Int,Int,Seq[BigInt],Boolean)] = None
+
+        def step(): Boolean = {
+          front.out.ready.poke((cycles%7 >= 3).B)
+          front.drawRetire.ready.poke((cycles%5 != 0).B)
+          for (i <- 0 until count) {
+            val port = dut.io.workers(i); val model = models(i)
+            if (port.flush.peek().litToBoolean && !model.started) {
+              assert(model.input.nonEmpty && model.input.size <= capacity)
+              assert(model.input.map(_.draw).distinct.size == 1)
+              model.output ++= model.input.filter(_.covered)
+              model.started = true
+              model.delay = if (i == 0) 23 else 2
+            }
+            val held = i == 0 && model.input.headOption.exists(s => blockedDraw.contains(s.draw))
+            port.fragIn.ready.poke((!model.started && model.input.size < capacity).B)
+            port.out.valid.poke((model.started && !held && model.delay==0 && model.output.nonEmpty).B)
+            port.drawRetire.valid.poke((model.started && !held && model.delay==0 && model.output.isEmpty).B)
+            port.drawRetire.bits.poke(true.B)
+            port.drained.poke((!model.started && model.input.isEmpty).B)
+            model.output.headOption.foreach { sample =>
+              port.out.bits.x.poke(sample.x.S)
+              port.out.bits.y.poke(1.S)
+              port.out.bits.depth.poke(sample.id.S)
+              port.out.bits.color.r.poke((sample.draw&255).U)
+              port.out.bits.covered.poke(true.B)
+              port.depthOverride.poke((sample.id%2 != 0).B)
+              for (s <- port.outDepths.indices) port.outDepths(s).poke((sample.id*10+s).U)
+            }
+          }
+          val accepted = front.fragIn.valid.peek().litToBoolean && front.fragIn.ready.peek().litToBoolean
+          if (accepted) for (lane <- 0 until 4) {
+            val p = front.fragIn.bits.lanes(lane)
+            val sample = Sample(p.depth.peek().litValue.toInt, producerDraw,
+              p.x.peek().litValue.toInt, p.covered.peek().litToBoolean)
+            if (sample.covered) { assert(!expected.contains(sample.id)); expected(sample.id)=sample }
+          }
+          val inputs = (0 until count).map { i =>
+            val port = dut.io.workers(i)
+            if (port.fragIn.valid.peek().litToBoolean && port.fragIn.ready.peek().litToBoolean) {
+              val bankStride = front.kernargBankStride.peek().litValue.toInt
+              port.kernargBase.expect((0x8000+2*i*bankStride).U)
+              if (bankStride == 0) assert(i==0, "zero stride escaped worker0")
+              Some((0 until 4).map { lane =>
+                val p=port.fragIn.bits.lanes(lane)
+                port.fragUv(lane).u.expect(front.fragUv(lane).u.peek())
+                Sample(p.depth.peek().litValue.toInt, producerDraw,
+                  p.x.peek().litValue.toInt, p.covered.peek().litToBoolean)
+              })
+            } else None
+          }
+          assert(inputs.count(_.nonEmpty)==(if (accepted) 1 else 0))
+          if (front.out.valid.peek().litToBoolean) {
+            val id=front.out.bits.depth.peek().litValue.toInt
+            val sample=expected(id)
+            val value=(id, front.out.bits.x.peek().litValue.toInt,
+              front.out.bits.color.r.peek().litValue.toInt,
+              front.outDepths.map(_.peek().litValue).toSeq, front.depthOverride.peek().litToBoolean)
+            stalled.foreach(old => assert(value==old, "stalled fragment/sideband changed"))
+            assert(sample.draw==retireCount, s"primitive ${sample.draw} escaped before consumer $retireCount")
+            assert(value._2==sample.x && value._3==(sample.draw&255))
+            assert(value._4==front.outDepths.indices.map(s => BigInt(id*10+s)))
+            assert(value._5==(id%2 != 0))
+            if (front.out.ready.peek().litToBoolean) {
+              assert(!observed.contains(id), "fragment emitted twice")
+              observed += id; stalled=None
+            } else stalled=Some(value)
+          } else assert(stalled.isEmpty, "stalled output disappeared")
+          if (front.drawRetire.valid.peek().litToBoolean && front.drawRetire.ready.peek().litToBoolean) {
+            assert(expected.values.filter(_.draw==retireCount).forall(s => observed.contains(s.id)),
+              "primitive retired with missing output")
+            retireCount += 1
+          }
+          val fires = dut.io.workers.map(p => p.out.valid.peek().litToBoolean && p.out.ready.peek().litToBoolean)
+          val retires = dut.io.workers.map(p => p.drawRetire.valid.peek().litToBoolean && p.drawRetire.ready.peek().litToBoolean)
+          dut.clock.step(); cycles += 1
+          for (i <- 0 until count) {
+            val model=models(i)
+            inputs(i).foreach(model.input ++= _)
+            if (fires(i)) model.output.dequeue()
+            if (retires(i)) { assert(model.output.isEmpty); model.input.clear(); model.started=false }
+            val held=i==0 && model.input.headOption.exists(s => blockedDraw.contains(s.draw))
+            if (!held && model.delay>0) model.delay -= 1
+          }
+          assert(cycles<30000, "primitive scheduling failed to make progress")
+          accepted
+        }
+        def quad(empty: Boolean=false, overlap: Boolean=false): Unit = {
+          front.flush.poke(false.B)
+          front.fragIn.valid.poke(true.B)
+          for (lane <- 0 until 4) {
+            val id=nextQuad*4+lane; val p=front.fragIn.bits.lanes(lane)
+            p.x.poke((if (overlap) lane else id).S)
+            p.y.poke(1.S); p.depth.poke(id.S)
+            p.covered.poke((!empty && id%3 != 0).B)
+            front.fragUv(lane).u.poke((id*11).U)
+          }
+          var accepted=false
+          while (!accepted) accepted=step()
+          front.fragIn.valid.poke(false.B); nextQuad += 1
+        }
+        def flush(): Unit = {
+          front.flush.poke(true.B); step(); producerDraw += 1
+          front.flush.poke(false.B); step()
+        }
+        def waitRetires(target: Int): Unit = while (retireCount<target) step()
+
+        for (_ <- 0 until 2*quadsPerBatch) quad()
+        for (_ <- 0 until 10) step()
+        if (count>1) assert(observed.nonEmpty,
+          "younger ready batch did not emit while oldest shader was held")
+        blockedDraw=None
+        // More than the token window: workers and completion tickets are
+        // reused while earlier batches of the same primitive remain live.
+        for (_ <- 0 until count*quadsPerBatch+1) quad()
+        flush(); flush(); waitRetires(2)
+        assert(observed.sorted.toSeq==expected.keys.toSeq.sorted)
+
+        // Same pixel positions in consecutive primitives. The younger one
+        // becomes ready while the old head is held, but cannot cross its end.
+        blockedDraw=Some(producerDraw)
+        quad(overlap=true); flush()
+        val before=observed.size
+        // One worker must finish its current batch before accepting another;
+        // only a multi-worker pool can queue the ready younger primitive.
+        if (count==1) blockedDraw=None
+        quad(overlap=true); flush()
+        for (_ <- 0 until 12) step()
+        if (count>1) assert(observed.size==before, "later primitive passed a held predecessor")
+        blockedDraw=None; waitRetires(4)
+
+        quad(empty=true); flush(); waitRetires(5)
+        for (_ <- 0 until quadsPerBatch) quad()
+        while (dut.io.assignedWorkers.peek().litValue != 0) step()
+        assert(retireCount==5, "batch completion retired the primitive early")
+        flush(); waitRetires(6)
+        front.kernargBankStride.poke(0.U)
+        for (_ <- 0 until 2*quadsPerBatch+1) quad()
+        flush(); waitRetires(7)
+        front.kernargBankStride.poke(stride.U)
+        // Exceed the epoch modulus, alternating empty, helper-only and live
+        // primitives while end and output readiness keep stalling.
+        for (i <- 0 until 40) {
+          if (i%3 != 0) quad(empty=i%3==1, overlap=true)
+          flush(); waitRetires(8+i)
+        }
+        for (_ <- 0 until 3) step()
+        assert(observed.sorted.toSeq==expected.keys.toSeq.sorted)
+        assert(retireCount==47 && producerDraw==47)
+        dut.io.assignedWorkers.expect(0.U)
+        front.drained.expect(true.B)
+        println(s"PRIMITIVE_DRAIN workers=$count lanes=$lanes warps=$warps cap=$capacity samples=${observed.size} epochs=$retireCount cycles=$cycles PASS")
+      }
+    }
+  }
+}
