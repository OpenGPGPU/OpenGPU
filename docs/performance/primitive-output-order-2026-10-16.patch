+package opengpu.graphics
+
+import chisel3._
+import chisel3.util._
+import opengpu.config.GpuConfig
+
+private class PrimitiveRetirementToken(ticketWidth: Int) extends Bundle {
+  val drawEnd = Bool()
+  val ticket = UInt(ticketWidth.W)
+}
+
+/** Drain ready whole batches of one raster primitive, retaining ordered
+  * primitive boundaries. The caller must provide unique covered pixel/sample
+  * positions within a primitive; arbitrary fragment streams use ordered mode.
+  * Shader outputs cannot change those positions. Holding a whole-batch grant
+  * preserves memory locality and stalled output/sideband stability.
+  */
+class PrimitiveFragmentScheduler(
+  config: GpuConfig,
+  gfxConfig: GraphicsConfig,
+  numWorkers: Int,
+  maxDraws: Int = 2,
+  reorder: Boolean = true
+) extends Module {
+  require(numWorkers > 0 && numWorkers <= ShaderResourceConfig.FieldMask / 2)
+  require(maxDraws > 0)
+  val io = IO(new Bundle {
+    val front = new KernelFragFrontendIO(config, gfxConfig)
+    val workers = Vec(numWorkers, Flipped(new KernelFragFrontendIO(config, gfxConfig)))
+    val assignedWorkers = Output(UInt(numWorkers.W))
+  })
+
+  if (!reorder || numWorkers == 1) {
+    val ordered = Module(new ParallelFragmentScheduler(config, gfxConfig, numWorkers, maxDraws))
+    io.front <> ordered.io.front
+    io.workers <> ordered.io.workers
+    io.assignedWorkers := ordered.io.assignedWorkers
+  } else {
+    val capacity = config.lanes * config.warps
+    val dispatchCapacity = if (gfxConfig.fragmentBatchLimit == 0) capacity
+      else gfxConfig.fragmentBatchLimit
+    require(capacity % 4 == 0 && dispatchCapacity > 0 && dispatchCapacity <= capacity &&
+      dispatchCapacity % config.lanes == 0)
+    val quadsPerBatch = dispatchCapacity / 4
+    val workerWidth = math.max(1, log2Ceil(numWorkers))
+    val quadWidth = math.max(1, log2Ceil(quadsPerBatch + 1))
+    val tickets = numWorkers + maxDraws
+    val ticketWidth = math.max(1, log2Ceil(tickets))
+    // Queued tokens plus pending ends bound the live epoch distance. Include
+    // the current unflushed primitive; wrap cannot alias an unretired epoch.
+    val epochWidth = math.max(1, log2Ceil(tickets + maxDraws + 2))
+    val producerEpoch = RegInit(0.U(epochWidth.W))
+    val consumerEpoch = RegInit(0.U(epochWidth.W))
+    val workerEpoch = Reg(Vec(numWorkers, UInt(epochWidth.W)))
+    val workerTicket = Reg(Vec(numWorkers, UInt(ticketWidth.W)))
+    val allocated = RegInit(VecInit(Seq.fill(numWorkers)(false.B)))
+    val sealedBatch = RegInit(VecInit(Seq.fill(numWorkers)(false.B)))
+    val ticketBusy = RegInit(VecInit(Seq.fill(tickets)(false.B)))
+    val ticketDone = RegInit(VecInit(Seq.fill(tickets)(false.B)))
+    val tokens = Module(new Queue(new PrimitiveRetirementToken(ticketWidth), tickets))
+    val freeTickets = ~ticketBusy.asUInt
+    val nextTicket = PriorityEncoder(freeTickets)
+    val collecting = RegInit(false.B)
+    val currentWorker = RegInit(0.U(workerWidth.W))
+    val quadCount = RegInit(0.U(quadWidth.W))
+    val previousFlush = RegNext(io.front.flush, false.B)
+    val flushRise = io.front.flush && !previousFlush
+    val pendingEnds = RegInit(0.U(log2Ceil(maxDraws + 1).W))
+    val endPending = pendingEnds =/= 0.U
+    val freeWorkers = VecInit((0 until numWorkers).map { w =>
+      !allocated(w) && (if (w == 0) true.B else io.front.kernargBankStride.orR)
+    }).asUInt
+    val selected = PriorityEncoder(freeWorkers)
+    val chosen = Mux(collecting, currentWorker, selected)
+    val chosenReady = MuxLookup(chosen, false.B)((0 until numWorkers).map { w =>
+      w.U -> io.workers(w).fragIn.ready
+    })
+    val acceptWindow = !endPending && !flushRise
+    val canPresent = acceptWindow && (collecting ||
+      (freeWorkers.orR && freeTickets.orR && tokens.io.enq.ready))
+    io.front.fragIn.ready := canPresent && chosenReady
+    tokens.io.enq.valid := freeTickets.orR && (endPending ||
+      (acceptWindow && !collecting && freeWorkers.orR && io.front.fragIn.valid && chosenReady))
+    tokens.io.enq.bits.drawEnd := endPending
+    tokens.io.enq.bits.ticket := nextTicket
+    val endEnqueued = tokens.io.enq.fire && endPending
+    when(flushRise =/= endEnqueued) {
+      pendingEnds := Mux(flushRise, pendingEnds + 1.U, pendingEnds - 1.U)
+    }
+    when(flushRise) { producerEpoch := producerEpoch + 1.U }
+    when(flushRise && !endEnqueued) {
+      assert(pendingEnds < maxDraws.U, "primitive end admission exceeded its bound")
+    }
+    when(tokens.io.enq.fire) {
+      ticketBusy(nextTicket) := true.B
+      ticketDone(nextTicket) := false.B
+    }
+    when(io.front.fragIn.fire) {
+      when(!collecting) {
+        currentWorker := selected
+        quadCount := 1.U
+        collecting := (quadsPerBatch > 1).B
+        workerEpoch(selected) := producerEpoch
+        workerTicket(selected) := nextTicket
+        assert(tokens.io.enq.fire && !tokens.io.enq.bits.drawEnd)
+      }.elsewhen(quadCount === (quadsPerBatch - 1).U) {
+        collecting := false.B
+        quadCount := 0.U
+      }.otherwise { quadCount := quadCount + 1.U }
+    }
+    when(flushRise && collecting) { collecting := false.B; quadCount := 0.U }
+
+    val draining = RegInit(false.B)
+    val drainWorker = RegInit(0.U(workerWidth.W))
+    val readyBatch = Module(new RRArbiter(UInt(workerWidth.W), numWorkers))
+    for (w <- 0 until numWorkers) {
+      readyBatch.io.in(w).valid := allocated(w) && sealedBatch(w) &&
+        workerEpoch(w) === consumerEpoch &&
+        (io.workers(w).out.valid || io.workers(w).drawRetire.valid)
+      readyBatch.io.in(w).bits := w.U
+    }
+    readyBatch.io.out.ready := !draining
+    when(readyBatch.io.out.fire) {
+      draining := true.B
+      drainWorker := readyBatch.io.out.bits
+    }
+    val owner = VecInit((0 until numWorkers).map(w => draining && drainWorker === w.U))
+    io.front.out.valid := (0 until numWorkers).map(w =>
+      owner(w) && io.workers(w).out.valid).reduce(_ || _)
+    io.front.out.bits := Mux1H((0 until numWorkers).map(w => owner(w) -> io.workers(w).out.bits))
+    io.front.outDepths := Mux1H((0 until numWorkers).map(w => owner(w) -> io.workers(w).outDepths))
+    io.front.depthOverride := (0 until numWorkers).map(w =>
+      owner(w) && io.workers(w).depthOverride).reduce(_ || _)
+    io.front.drawRetire.valid := tokens.io.deq.valid && tokens.io.deq.bits.drawEnd && !draining
+    io.front.drawRetire.bits := true.B
+    tokens.io.deq.ready := Mux(tokens.io.deq.bits.drawEnd,
+      io.front.drawRetire.ready && !draining, ticketDone(tokens.io.deq.bits.ticket))
+    when(tokens.io.deq.fire) { ticketBusy(tokens.io.deq.bits.ticket) := false.B }
+    when(io.front.drawRetire.fire) { consumerEpoch := consumerEpoch + 1.U }
+
+    for (w <- 0 until numWorkers) {
+      val port = io.workers(w)
+      port.fragIn.valid := io.front.fragIn.valid && canPresent && chosen === w.U
+      port.fragIn.bits := io.front.fragIn.bits
+      port.fragUv := io.front.fragUv
+      port.fragDepths := io.front.fragDepths
+      port.shaderPc := io.front.shaderPc
+      port.inputSkip := io.front.inputSkip
+      port.outputSkip := io.front.outputSkip
+      port.abi1 := io.front.abi1
+      port.kernargBase := io.front.kernargBase + io.front.kernargBankStride * (2*w).U
+      port.kernargBankStride := io.front.kernargBankStride
+      port.texFormat := io.front.texFormat
+      port.texBase := io.front.texBase
+      port.texWidth := io.front.texWidth
+      port.texHeight := io.front.texHeight
+      port.texWrapClamp := io.front.texWrapClamp
+      port.texMaxLevel := io.front.texMaxLevel
+      port.texLodBias := io.front.texLodBias
+      port.texMinLevel := io.front.texMinLevel
+      port.flush := sealedBatch(w)
+      port.out.ready := owner(w) && io.front.out.ready
+      port.drawRetire.ready := owner(w)
+      when(port.fragIn.fire) {
+        assert(!sealedBatch(w), "cannot append to a sealed primitive batch")
+        when(!collecting) { allocated(w) := true.B }
+        when((!collecting && (quadsPerBatch == 1).B) ||
+          (collecting && quadCount === (quadsPerBatch - 1).U)) { sealedBatch(w) := true.B }
+      }
+      when(flushRise && collecting && currentWorker === w.U) { sealedBatch(w) := true.B }
+      when(port.drawRetire.fire) {
+        assert(allocated(w) && ticketBusy(workerTicket(w)) && !ticketDone(workerTicket(w)))
+        assert(workerEpoch(w) === consumerEpoch, "later primitive retired early")
+        ticketDone(workerTicket(w)) := true.B
+        allocated(w) := false.B
+        sealedBatch(w) := false.B
+        draining := false.B
+      }
+    }
+    io.assignedWorkers := allocated.asUInt
+    io.front.drained := !tokens.io.deq.valid && !allocated.asUInt.orR &&
+      !collecting && !endPending && !flushRise && !draining &&
+      io.workers.map(_.drained).reduce(_ && _)
+  }
+}
