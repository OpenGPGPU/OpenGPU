  "contract": {
    "coordinates": "Unsigned 32-bit Q16.16",
    "extent": "Every nonzero 14-bit width/height, 1..16383",
    "arithmetic": "Full-precision floor(coord * extent / 256) - 128 in texel Q8, followed by floor-modulo for REPEAT or saturation for CLAMP. No new wrap mode or signed-negative coordinate support.",
    "mip": "Existing packed chain and serial walk retained; each level halves with floor and a minimum extent of one."
  },
  "change": {
    "coordinate_pipeline": "Shared bounded coordinate arithmetic; 17x14 multiply, 24-bit signed biased coordinate instead of a 32x14 multiply and 38-bit biased value. Six elastic stages retained.",
    "overlap_sampler": "Capture raw low16 partial products alongside two clamp-high predicates. Ignore whole periods for REPEAT. For unsaturated CLAMP, one high input bit supplies the remaining product; saturated CLAMP selects a positive period sentinel at the existing join stage. No added cycle.",
    "indices": "Second tap wraps on equality with extent instead of bit masking."
  },
  "arithmetic_argument": {
    "repeat": "Write c = 65536*k + f. floor(c*n/256)-128 = 256*n*k + floor(f*n/256)-128, so discarding k preserves modulo 256*n. The reduced value lies in [-128,256*n), requiring at most one period addition.",
    "clamp": "For c >= 98304, floor(c*n/256)-128 >= 384*n-128 > 256*n-1 for n>=1. Capping there or supplying a period sentinel preserves the saturated result. Smaller c fits 17 bits.",
    "width": "At n=16383, the bounded biased maximum is 6290944; minimum is -128. Both fit signed24.",
    "proof_limit": "Algebraic argument and numeric RTL tests; not a universal RTL formal proof."
  },
