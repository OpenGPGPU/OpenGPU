#version 310 es
#extension GL_EXT_texture_buffer:require
precision highp int;
layout(local_size_x=8,local_size_y=4,local_size_z=4) in;
layout(binding=0) uniform highp usamplerBuffer src[32];
layout(std430,binding=0) buffer Output0 {uint v[];} o0;
layout(std430,binding=1) buffer Output1 {uint v[];} o1;
layout(std430,binding=2) buffer Output2 {uint v[];} o2;
layout(std430,binding=3) buffer Output3 {uint v[];} o3;
void main(){uint x=texelFetch(src[31],textureSize(src[31])).x;
o0.v[gl_LocalInvocationIndex]=x^0u;
o1.v[gl_LocalInvocationIndex]=x^1u;
o2.v[gl_LocalInvocationIndex]=x^2u;
o3.v[gl_LocalInvocationIndex]=x^3u;
}
