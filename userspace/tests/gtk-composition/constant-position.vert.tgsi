VERT
PROPERTY NEXT_SHADER VERT
DCL OUT[0], POSITION
DCL CONST[0][0..4]
DCL TEMP[0]
  0: MUL TEMP[0], CONST[0][4].xxxx, CONST[0][0]
  1: MAD TEMP[0], CONST[0][4].yyyy, CONST[0][1], TEMP[0]
  2: MAD TEMP[0], CONST[0][4].zzzz, CONST[0][2], TEMP[0]
  3: MAD OUT[0], CONST[0][4].wwww, CONST[0][3], TEMP[0]
  4: END
