#!/bin/sh
# Preserve the builder's environment before a system Python launcher can add
# SDK/include defaults. The adapter restores it before invoking the compiler.
set -eu
export OPENGPU_CACHE_PARENT_ENV=1
export OPENGPU_CACHE_PARENT_SDKROOT="${SDKROOT+x}${SDKROOT-}"
export OPENGPU_CACHE_PARENT_CPATH="${CPATH+x}${CPATH-}"
export OPENGPU_CACHE_PARENT_CPLUS_INCLUDE_PATH="${CPLUS_INCLUDE_PATH+x}${CPLUS_INCLUDE_PATH-}"
export OPENGPU_CACHE_PARENT_MACOSX_DEPLOYMENT_TARGET="${MACOSX_DEPLOYMENT_TARGET+x}${MACOSX_DEPLOYMENT_TARGET-}"
export OPENGPU_CACHE_PARENT_DEVELOPER_DIR="${DEVELOPER_DIR+x}${DEVELOPER_DIR-}"
export OPENGPU_CACHE_PARENT_TOOLCHAINS="${TOOLCHAINS+x}${TOOLCHAINS-}"
export OPENGPU_CACHE_PARENT_C_INCLUDE_PATH="${C_INCLUDE_PATH+x}${C_INCLUDE_PATH-}"
export OPENGPU_CACHE_PARENT_OBJC_INCLUDE_PATH="${OBJC_INCLUDE_PATH+x}${OBJC_INCLUDE_PATH-}"
export OPENGPU_CACHE_PARENT_CCC_OVERRIDE_OPTIONS="${CCC_OVERRIDE_OPTIONS+x}${CCC_OVERRIDE_OPTIONS-}"
export OPENGPU_CACHE_PARENT_CCC_CXXFLAGS="${CCC_CXXFLAGS+x}${CCC_CXXFLAGS-}"
export OPENGPU_CACHE_PARENT_LIBRARY_PATH="${LIBRARY_PATH+x}${LIBRARY_PATH-}"
export OPENGPU_CACHE_PARENT_SOURCE_DATE_EPOCH="${SOURCE_DATE_EPOCH+x}${SOURCE_DATE_EPOCH-}"
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
exec python3 "$script_dir/cache_native_flashsim_compiler.py" --compiler-adapter "$@"
