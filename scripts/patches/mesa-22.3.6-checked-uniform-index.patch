+/* Test typed array indices before stride multiplication can discard their
+ * high bits.  In particular, a 32-bit vec4 index must not become an in-bounds
+ * UBO offset merely because index * 16 wraps.  Stop at a cast: its parent is
+ * an address, not necessarily another deref.  Unsized/pointer arrays have no
+ * typed bound here and retain their existing lowering.
+ */
+static nir_ssa_def *
+uniform_array_in_bounds(nir_builder *b, nir_deref_instr *deref)
+{
+   nir_ssa_def *in_bounds = NULL;
+   for (; deref; deref = nir_deref_instr_parent(deref)) {
+      if (deref->deref_type == nir_deref_type_var ||
+          deref->deref_type == nir_deref_type_cast)
+         break;
+      if (deref->deref_type != nir_deref_type_array)
+         continue;
+
+      nir_deref_instr *parent = nir_deref_instr_parent(deref);
+      unsigned length = glsl_type_is_vector(parent->type) ?
+                        glsl_get_vector_elements(parent->type) :
+                        glsl_get_length(parent->type);
+      if (!length)
+         continue;
+
+      nir_ssa_def *index = nir_ssa_for_src(b, deref->arr.index, 1);
+      /* A narrow index whose entire domain fits needs no comparison. */
+      if (index->bit_size < 32 && length >= (1u << index->bit_size))
+         continue;
+      nir_ssa_def *valid = nir_ult(b, index,
+                                 nir_imm_intN_t(b, length, index->bit_size));
+      in_bounds = in_bounds ? nir_iand(b, in_bounds, valid) : valid;
+   }
+   return in_bounds;
+}
